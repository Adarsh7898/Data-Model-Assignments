<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">

    <description>Relationshipmgr CRUD Services using Entity-Auto</description>

    <!-- ========================================== -->
    <!-- 1. Party Services                          -->
    <!-- ========================================== -->

    <!-- Creates the supertype Party and auto-generates the partyId -->
    <service name="createPartyA" default-entity-name="PartyA" engine="entity-auto" invoke="create" auth="true">
        <description>Create a base Party and auto-generate partyId</description>
        <auto-attributes mode="IN" include="pk" optional="true"/>
        <auto-attributes mode="IN" include="nonpk" optional="true"/>
        <override name="partyId" mode="OUT"/>
    </service>

    <!-- Creates PersonA -->
    <service name="createPersonA" default-entity-name="PersonA" engine="entity-auto" invoke="create" auth="true">
        <description>Create a Person record linked to a Party</description>
        <auto-attributes mode="IN" include="pk" optional="false"/>
        <auto-attributes mode="IN" include="nonpk" optional="true"/>
    </service>

    <!-- Creates OrganizationA -->
    <service name="createOrganizationA" default-entity-name="OrganizationA" engine="entity-auto" invoke="create" auth="true">
        <description>Create an Organization record linked to a Party</description>
        <auto-attributes mode="IN" include="pk" optional="false"/>
        <auto-attributes mode="IN" include="nonpk" optional="true"/>
    </service>

    <!-- ========================================== -->
    <!-- 2. Role Assignment Service                 -->
    <!-- ========================================== -->

    <service name="createPartyRoleA" default-entity-name="PartyRoleA" engine="entity-auto" invoke="create" auth="true">
        <description>Assign a Role to a Party</description>
        <auto-attributes mode="IN" include="pk" optional="false"/>
    </service>

    <!-- ========================================== -->
    <!-- 3. Contact Mechanism Services              -->
    <!-- ========================================== -->

    <!-- Creates the base ContactMech -->
    <service name="createContactMechA" default-entity-name="ContactMechA" engine="entity-auto" invoke="create" auth="true">
        <description>Create standard Contact Mechanism</description>
        <auto-attributes mode="IN" include="pk" optional="true"/>
        <auto-attributes mode="IN" include="nonpk" optional="true"/>
        <override name="contactMechId" mode="OUT"/>
    </service>

    <!-- Creates PostalAddressA -->
    <service name="createPostalAddressA" default-entity-name="PostalAddressA" engine="entity-auto" invoke="create" auth="true">
        <description>Create Postal Address linked to ContactMech</description>
        <auto-attributes mode="IN" include="pk" optional="false"/>
        <auto-attributes mode="IN" include="nonpk" optional="true"/>
    </service>

    <!-- Creates TelecomNumberA -->
    <service name="createTelecomNumberA" default-entity-name="TelecomNumberA" engine="entity-auto" invoke="create" auth="true">
        <description>Create Telecom Number linked to ContactMech</description>
        <auto-attributes mode="IN" include="pk" optional="false"/>
        <auto-attributes mode="IN" include="nonpk" optional="true"/>
    </service>

    <!-- ========================================== -->
    <!-- 4. Party Contact Association Services      -->
    <!-- ========================================== -->

    <service name="createPartyContactMechA" default-entity-name="PartyContactMechA" engine="entity-auto" invoke="create" auth="true">
        <description>Bind Contact Mechanism to Party</description>
        <auto-attributes mode="IN" include="pk" optional="true"/>
        <auto-attributes mode="IN" include="nonpk" optional="true"/>
        <override name="fromDate" mode="INOUT" optional="true"/>
    </service>

</services>